# Copy this file to .env (or export these variables directly in your shell)
# to configure the LLM backend without editing config/llm_api_config.json
# or passing --api-url/--api-key/--model on every CLI invocation.
#
# Precedence (highest wins): CLI flag > environment variable > JSON config
# file (config/llm_api_config.json) > built-in default.

# OpenAI-compatible /v1/chat/completions endpoint.
# Examples:
#   Ollama (local):     http://localhost:11434/v1/chat/completions
#   LM Studio (local):  http://localhost:1234/v1/chat/completions
#   OpenAI:             https://api.openai.com/v1/chat/completions
LLM_API_URL=http://localhost:11434/v1/chat/completions

# Bearer token, if your backend requires one. Leave empty for backends
# that don't need authentication (e.g. a local Ollama/LM Studio server).
# Never commit a real value for this -- use this file only as a local,
# untracked source of secrets (it's already covered by .gitignore's `.env`).
LLM_API_KEY=

# Model name to request from the backend.
LLM_MODEL=gemma2:latest
